<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UndergroundGunsmith</AssemblyName>
    <RootNamespace>UndergroundGunsmith</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    默认假设本仓库位于 <游戏目录>/Modding/UndergroundGunsmith/（官方推荐的开发布局）。
    游戏装在别处时可以用 -p:GameDir 覆盖，例如：
      dotnet build -c Release -p:GameDir="D:\Steam\steamapps\common\Probably Stolen\"
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\..\</GameDir>
    <GameManagedDir>$(GameDir)Probably Stolen_Data\Managed\</GameManagedDir>
    <ModFolderName Condition="'$(ModFolderName)' == ''">UndergroundGunsmith</ModFolderName>
    <!-- 编译产物直接落到 <游戏目录>/Mods/UndergroundGunsmith/，游戏按该目录识别模组 -->
    <OutputPath Condition="'$(OutputPath)' == ''">$(GameDir)Mods\$(ModFolderName)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManagedDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Localization\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
